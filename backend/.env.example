# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database (PostgreSQL) ----------
# Option A (recommended, works with free Neon/Supabase): one connection string
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Option B (local PostgreSQL installed on your computer):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devsecops
DB_USER=postgres
# Must be EXACTLY the password of your PostgreSQL "postgres" user (set when you installed PostgreSQL).
DB_PASSWORD=changeme

# ---------- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----------
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Encrypts users' GitHub tokens in the database. Changing it logs everyone out of GitHub.
TOKEN_ENC_KEY=replace_with_another_long_random_secret
# Shared with the scan workflow (GitHub Actions secret SCAN_SECRET - must be identical)
SCAN_SECRET=replace_with_a_third_long_random_secret

# ---------- Frontend ----------
# Your frontend URL(s), comma separated. Used for CORS and the GitHub OAuth redirect.
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Scanner workflow (the repo that contains .github/workflows/scan-repository.yml) ----------
SCANNER_REPO=your-github-username/devsecops-platform
SCANNER_REPO_REF=main
# Personal access token with Actions: Read and write on SCANNER_REPO
SCANNER_REPO_TOKEN=

# ---------- GitHub OAuth: "Sign in with GitHub" + "Connect with GitHub" (no token needed) ----------
# Create at GitHub > Settings > Developer settings > OAuth Apps.
# Homepage URL: your frontend URL.  Callback URL: <backend-url>/api/github/oauth/callback
# Local test: http://localhost:5000/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Forgot password e-mail (SMTP) ----------
# Leave empty during development: the reset link is then printed in the backend terminal.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Gmail "App password">, MAIL_FROM="TechShield <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: public website address used inside e-mails (defaults to FRONTEND_ORIGIN)
# FRONTEND_URL=https://your-frontend.vercel.app
